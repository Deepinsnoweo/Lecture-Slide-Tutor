# Slide Tutor — LLM configuration
# Copy this file to .env and fill in your values.
# .env is git-ignored and will never be committed.

# DeepSeek API (recommended)
SLIDE_TUTOR_BASE_URL=https://api.deepseek.com
SLIDE_TUTOR_API_KEY=your-deepseek-api-key
SLIDE_TUTOR_MODEL=deepseek-flash
# Optional: use a lightweight model for Q&A context planning.
# If SLIDE_TUTOR_QA_PLANNER_MODEL is unset, it uses SLIDE_TUTOR_LIGHTWEIGHT_MODEL.
# If both are unset, it falls back to SLIDE_TUTOR_MODEL.
# SLIDE_TUTOR_LIGHTWEIGHT_MODEL=your-lightweight-model
# SLIDE_TUTOR_QA_PLANNER_MODEL=your-planner-model

# Optional native single-turn Function Calling for Free Ask. Keep disabled until
# the configured Provider has been live-verified; unsupported Providers fall
# back to the legacy JSON context planner automatically.
# SLIDE_TUTOR_QA_TOOL_CALLING=false
# SLIDE_TUTOR_QA_TOOL_CALLING_MAX_CALLS=4

# Optional bounded multi-round Free Ask Agent v2. A controlled DeepSeek
# page→search→finish gate is recorded, but keep this opt-in flag disabled unless
# you explicitly choose to send the selected course context to the Provider.
# v2 has its own flag and falls back to v1.
# SLIDE_TUTOR_QA_AGENT=false
# SLIDE_TUTOR_QA_AGENT_MODEL=your-agent-model
# SLIDE_TUTOR_QA_AGENT_MAX_ROUNDS=3
# SLIDE_TUTOR_QA_AGENT_MAX_CALLS_PER_ROUND=4
# SLIDE_TUTOR_QA_AGENT_MAX_TOTAL_CALLS=6
# SLIDE_TUTOR_QA_AGENT_MAX_SECONDS=45
# SLIDE_TUTOR_QA_AGENT_MAX_CONTROLLER_TOKENS=0

# Or use local Ollama:
# SLIDE_TUTOR_BASE_URL=http://localhost:11434/v1
# SLIDE_TUTOR_API_KEY=ollama
# SLIDE_TUTOR_MODEL=llama3.2

# Or use OpenAI:
# SLIDE_TUTOR_BASE_URL=https://api.openai.com/v1
# SLIDE_TUTOR_API_KEY=your-openai-api-key
# SLIDE_TUTOR_MODEL=gpt-4o-mini

# Retrieval embedding model loading is local-only by default. Set this to
# false only when you explicitly want the Hugging Face cache to fetch models.
# SLIDE_TUTOR_EMBEDDING_LOCAL_FILES_ONLY=true
# SLIDE_TUTOR_EMBEDDING_PREFLIGHT_TIMEOUT_SECONDS=15

# Marker is also local-only by default so a pre-index job never waits through
# repeated network retries. Set false only while intentionally fetching models.
# SLIDE_TUTOR_MARKER_LOCAL_FILES_ONLY=true
# SLIDE_TUTOR_MARKER_BATCH_PAGES=8
